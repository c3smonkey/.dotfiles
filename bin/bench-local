#!/usr/bin/env python3
"""bench-local – misst lokale Ollama-Modelle mit echten Aufgaben aus dem aktuellen Git-Repo.

Nutzung (im Repo-Verzeichnis):
  bench-local                         # alle installierten Text-Modelle
  bench-local -m qwen2.5-coder:7b -m qwen2.5-coder:14b
  bench-local --tasks commit,log      # nur bestimmte Aufgaben

Ausgabe:
  - Tabelle mit Ladezeit, Einlesezeit, Tokens/s und Gesamtzeit pro Modell und Aufgabe
  - Datei bench-results-<datum>.md mit allen Antworten (zur Qualitätsbewertung)

Nach jedem Modell wird es aus dem Speicher entladen, damit sich die Modelle nicht gegenseitig bremsen.
"""
import argparse
import datetime
import glob
import json
import os
import subprocess
import sys
import urllib.error
import urllib.request

HOST = os.environ.get("OLLAMA_HOST", "http://localhost:11434").rstrip("/")
if not HOST.startswith("http"):
    HOST = "http://" + HOST

# Modelle, die für Text-/Code-Aufgaben nicht taugen
SKIP_HINTS = ("embed", "vision", "llava", "minicpm-v", "bakllava", "moondream")

SYSTEM = ("Du bist ein präziser Senior-Entwickler (Go, TypeScript). "
          "Antworte knapp und konkret, ohne Einleitung.")


def sh(cmd, limit=12000):
    try:
        out = subprocess.check_output(cmd, shell=True, text=True, stderr=subprocess.DEVNULL)
    except subprocess.CalledProcessError:
        return ""
    return out[:limit]


def build_tasks():
    tasks = {}
    diff = sh("git show HEAD --stat --patch --no-color --format=", 10000)
    if diff:
        tasks["commit"] = ("Commit-Message",
                           f"```\n{diff}\n```\n\nSchreib eine Conventional-Commit-Message "
                           "(Titel max. 72 Zeichen, dann 2-4 Stichpunkte).")
    log = sh("git log --oneline -40 --no-color", 6000)
    if log:
        tasks["log"] = ("Verlauf zusammenfassen",
                        f"```\n{log}\n```\n\nFasse die letzten Änderungen in genau 3 Stichpunkten zusammen.")
    fixtures = sorted(glob.glob("fixtures/bingx/*.json"))
    if fixtures:
        with open(fixtures[0], encoding="utf-8", errors="replace") as f:
            data = f.read()[:8000]
        tasks["fixture"] = (f"Fixture-Felder ({os.path.basename(fixtures[0])})",
                            f"```json\n{data}\n```\n\nListe alle Felder der Einträge mit Pfad, Typ "
                            "und Beispielwert als Markdown-Tabelle. Nur die Tabelle.")
    return tasks


def api(path, body=None, method="POST"):
    data = json.dumps(body).encode() if body is not None else None
    req = urllib.request.Request(f"{HOST}{path}", data=data, method=method,
                                 headers={"Content-Type": "application/json"})
    with urllib.request.urlopen(req, timeout=900) as r:
        return json.loads(r.read() or b"{}")


def installed_models():
    tags = api("/api/tags", method="GET").get("models", [])
    names = [m["name"] for m in tags]
    return [n for n in names if not any(h in n.lower() for h in SKIP_HINTS)]


def run(model, prompt):
    res = api("/api/generate", {
        "model": model, "system": SYSTEM, "prompt": prompt, "stream": False,
        "keep_alive": "5m", "options": {"temperature": 0.2, "num_ctx": 8192},
    })
    ns = 1e9
    ev, evd = res.get("eval_count", 0), res.get("eval_duration", 0) or 1
    return {
        "answer": res.get("response", "").strip(),
        "load": res.get("load_duration", 0) / ns,
        "prompt": res.get("prompt_eval_duration", 0) / ns,
        "tps": ev / (evd / ns),
        "total": res.get("total_duration", 0) / ns,
        "out_tokens": ev,
    }


def unload(model):
    try:
        api("/api/generate", {"model": model, "keep_alive": 0})
    except Exception:
        pass


def main():
    p = argparse.ArgumentParser(description="Lokale Ollama-Modelle mit Repo-Aufgaben messen")
    p.add_argument("-m", "--model", action="append", help="Modell (mehrfach möglich)")
    p.add_argument("--tasks", help="Kommagetrennt: commit,log,fixture")
    args = p.parse_args()

    try:
        models = args.model or installed_models()
    except urllib.error.URLError as e:
        sys.exit(f"bench-local: Ollama nicht erreichbar unter {HOST} ({e.reason})")
    tasks = build_tasks()
    if args.tasks:
        wanted = set(args.tasks.split(","))
        tasks = {k: v for k, v in tasks.items() if k in wanted}
    if not tasks:
        sys.exit("bench-local: keine Aufgaben gefunden (im Git-Repo ausführen?)")

    print(f"Modelle: {', '.join(models)}\nAufgaben: {', '.join(tasks)}\n", file=sys.stderr)
    rows, answers = [], []
    for model in models:
        for key, (title, prompt) in tasks.items():
            print(f"… {model} / {key}", file=sys.stderr, flush=True)
            try:
                r = run(model, prompt)
            except urllib.error.HTTPError as e:
                print(f"  übersprungen ({e.code})", file=sys.stderr)
                continue
            except Exception as e:
                print(f"  Fehler: {e}", file=sys.stderr)
                continue
            rows.append((model, key, r))
            answers.append(f"## {model} — {title}\n\n"
                           f"_{r['total']:.1f} s gesamt, {r['tps']:.1f} tok/s, "
                           f"{r['out_tokens']} Tokens_\n\n{r['answer']}\n")
        unload(model)

    header = "| Modell | Aufgabe | Laden s | Einlesen s | tok/s | Gesamt s |\n|---|---|---|---|---|---|"
    lines = [header] + [
        f"| {m} | {k} | {r['load']:.1f} | {r['prompt']:.1f} | {r['tps']:.1f} | {r['total']:.1f} |"
        for m, k, r in rows
    ]
    table = "\n".join(lines)
    print(table)

    stamp = datetime.datetime.now().strftime("%Y%m%d-%H%M")
    out = f"bench-results-{stamp}.md"
    with open(out, "w", encoding="utf-8") as f:
        f.write(f"# bench-local {stamp}\n\n{table}\n\n---\n\n" + "\n---\n\n".join(answers))
    print(f"\nAntworten zur Qualitätsprüfung: {out}", file=sys.stderr)


if __name__ == "__main__":
    main()
