#!/usr/bin/env python3
"""ask-local – schickt eine Frage (+ optional stdin / Dateien) an ein lokales Ollama-Modell.

Beispiele:
  git diff --staged | ask-local "Schreib eine kurze Commit-Message (Conventional Commits)"
  tail -n 300 app.log | ask-local "Was ist die Ursache des Fehlers?"
  ask-local -f internal/orders/service.go "Erklär diese Datei in 5 Punkten"
  ask-local -m qwen2.5-coder:7b "Regex für ISO-Datum"
  ask-local --fast "Commit-Message" < diff.txt   # schnelles 7b-Modell

Gut für EINE Quelle (Log, Diff, Datei). Schwach bei Vergleichen mehrerer Quellen.

Umgebungsvariablen:
  ASK_LOCAL_MODEL  (Default: qwen2.5-coder:14b)
  OLLAMA_HOST      (Default: http://localhost:11434)
"""
import argparse
import json
import os
import sys
import urllib.request

DEFAULT_MODEL = os.environ.get("ASK_LOCAL_MODEL", "qwen2.5-coder:14b")
FAST_MODEL = os.environ.get("ASK_LOCAL_FAST_MODEL", "qwen2.5-coder:7b")
KEEP_ALIVE = os.environ.get("ASK_LOCAL_KEEP_ALIVE", "30m")
MAX_CTX = 32768          # mehr wird auf dem Air zu langsam / zu speicherhungrig
CHARS_PER_TOKEN = 3.5    # grobe Schätzung
HOST = os.environ.get("OLLAMA_HOST", "http://localhost:11434").rstrip("/")
if not HOST.startswith("http"):
    HOST = "http://" + HOST


SYSTEM = (
    "Du bist ein präziser Senior-Entwickler (Go, TypeScript). "
    "Antworte knapp und konkret. Keine Einleitung, kein Fülltext. "
    "Wenn du dir unsicher bist, sag es."
)


def main():
    p = argparse.ArgumentParser(description="Frage an lokales Ollama-Modell")
    p.add_argument("prompt", nargs="+", help="Die Frage / Aufgabe")
    p.add_argument("-m", "--model", default=DEFAULT_MODEL)
    p.add_argument("-f", "--file", action="append", default=[], help="Datei anhängen (mehrfach möglich)")
    p.add_argument("--fast", action="store_true", help=f"schnelles Modell ({FAST_MODEL})")
    p.add_argument("-c", "--ctx", type=int, default=0, help="Kontextfenster in Tokens (Default: automatisch)")
    args = p.parse_args()

    parts = []
    for path in args.file:
        try:
            with open(path, encoding="utf-8", errors="replace") as fh:
                parts.append(f"### Datei: {path}\n```\n{fh.read()}\n```")
        except OSError as e:
            sys.exit(f"ask-local: kann {path} nicht lesen: {e}")

    if not sys.stdin.isatty():
        data = sys.stdin.read()
        if data.strip():
            parts.append(f"### Eingabe\n```\n{data}\n```")

    if args.fast:
        args.model = FAST_MODEL

    context = "\n\n".join(parts)
    reserve = 2048  # Platz für Aufgabe + Antwort
    max_chars = int((MAX_CTX - reserve) * CHARS_PER_TOKEN)
    if len(context) > max_chars:
        half = max_chars // 2
        cut = len(context) - max_chars
        context = (context[:half]
                   + f"\n\n[... {cut} Zeichen in der Mitte ausgelassen ...]\n\n"
                   + context[-half:])
        print(f"[ask-local] WARNUNG: Eingabe zu lang, {cut} Zeichen in der Mitte ausgelassen. "
              f"Ergebnis kann unvollständig sein. Besser: Eingabe vorher eingrenzen.", file=sys.stderr)

    if not args.ctx:
        est = int(len(context) / CHARS_PER_TOKEN) + reserve
        args.ctx = min(MAX_CTX, max(4096, ((est // 4096) + 1) * 4096))

    prompt = " ".join(args.prompt)
    full = f"{context}\n\n### Aufgabe\n{prompt}" if context else prompt

    body = json.dumps({
        "model": args.model,
        "system": SYSTEM,
        "prompt": full,
        "stream": True,
        "keep_alive": KEEP_ALIVE,
        "options": {"num_ctx": args.ctx, "temperature": 0.2},
    }).encode()

    req = urllib.request.Request(f"{HOST}/api/generate", data=body,
                                 headers={"Content-Type": "application/json"})
    try:
        with urllib.request.urlopen(req) as resp:
            for line in resp:
                if not line.strip():
                    continue
                chunk = json.loads(line)
                if "error" in chunk:
                    sys.exit(f"ask-local: {chunk['error']}")
                sys.stdout.write(chunk.get("response", ""))
                sys.stdout.flush()
                if chunk.get("done"):
                    break
    except urllib.error.HTTPError as e:
        try:
            msg = json.loads(e.read()).get("error", e.reason)
        except Exception:
            msg = e.reason
        hint = f"\n→ Modell holen mit: ollama pull {args.model}" if e.code == 404 else ""
        sys.exit(f"ask-local: Ollama-Fehler {e.code}: {msg}{hint}")
    except urllib.error.URLError as e:
        sys.exit(f"ask-local: Ollama nicht erreichbar unter {HOST} ({e.reason}). Läuft der Server?")
    print()


if __name__ == "__main__":
    main()
